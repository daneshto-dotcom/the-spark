node_modules/
dist/
.vite/
*.log
.DS_Store
.env
.env.local
.claude/session-state.json.bak
.claude/session-state.json.tmp.*
.claude/session-state.json.lockdir/
.claude/session-state.json.lockdir.zombie.*/
.claude/session-port.json
tsconfig.tsbuildinfo

# Per-session transient artifacts (S106 .gitignore extension 2026-05-10)
.claude/session-summary.md
.claude/state-hash.tmp
.claude/pdr-user-responded
.claude/budget-reported-*
.claude/pdr-deliberation-*
.claude/pdr-token-*
.claude/pdr-user-confirmed-*

# S46 P1 — Playwright E2E artifacts
playwright-report/
test-results/
test-results-quarantine/
test-results-soak/
test-results-protocol/
# S155 P1 — the new GATING lobby lane writes its own --output dir (same reason every other
# lane has one: so a lane never overwrites another lane's report/traces). It was not listed,
# so the P1 commit swept in test-results-lobby/ AND a throwaway probe dir complete with
# failure screenshots. The catch-all stops the next ad-hoc probe dir doing the same.
test-results-lobby/
test-results-*/
.playwright-cache/

# S74 — root handoff docs are ephemeral; the permanent copy lives in .handoff-archive/
# (tracked). Root-anchored (leading /) so .handoff-archive/HANDOFF_*.md is NOT ignored.
/HANDOFF_*.md

# S90 — stray captured build-log output (e.g. `npm run build > build-out.txt`); never a tracked artifact.
/build-out.txt
/*-out.txt
/e2e-watch-*.log
# S133 — transient pre-handoff review flag (created/cleared by pre-handoff-review.py)
.claude/REVIEW-PENDING.flag

# S152 P1 — transient capture logs from a verification run (never a tracked artifact).
.claude/p1-*.txt
.claude/p2-*.txt
.claude/p3-*.txt
.claude/pf-*.txt
.claude/preflight-*.log

# S152 P3 — gen-character-design.mjs intermediates. The design PNG and the spec ARE tracked
# (S151 kept neither and its atlases became unrebuildable); the raw API request/response
# payloads are not — a .resp carries the whole base64 image and would double the repo cost.
assets-source/**/.req-*.json
assets-source/**/.resp-*.json
assets-source/**/*.raw
